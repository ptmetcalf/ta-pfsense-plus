{
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "app.manifest",
          "jsonpath": "$.info.id.version"
        },
        {
          "type": "regex",
          "path": "default/app.conf",
          "pattern": "version = (?<version>\\d+\\.\\d+\\.\\d+)"
        }
      ]
    }
  }
}
